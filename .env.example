# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and must never be committed.

# --- Data source ---
# "json" (default) reads/writes the local data/*.json files — no database
# needed, good for local dev or when you don't have a MongoDB connection.
# Set to "mongodb" (and fill in MONGODB_URI below) to use a real database.
DATA_SOURCE=json

# --- Database (only required when DATA_SOURCE=mongodb) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# --- Auth ---
# Long random string used to sign JWTs
JWT_SECRET=

# --- Cloudinary (admin image uploads) ---
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Contact form email (Gmail SMTP) ---
USER_EMAIL=
APP_PASSWORD=
# Optional: where contact submissions are delivered (defaults to USER_EMAIL)
CONTACT_RECIPIENT_EMAIL=

# --- Database seeding (POST /api/seed with header x-seed-secret) ---
# Long random string; the seed endpoint is disabled unless this is set.
SEED_SECRET=

# --- Stripe ---
# Publishable key is exposed to the browser (NEXT_PUBLIC_ prefix is required)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
